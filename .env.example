# --- Telegram: the live channel ---
# Bot from @BotFather. TELEGRAM_SECRET must match what the webhook was set with
# (bin/webhook.js reads it from here), or Telegram's POSTs are refused 403.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_HANDLE=@callher_bot
TELEGRAM_SECRET=

# --- Storage: Vercel Blob ---
# Injected automatically on Vercel once a Blob store is linked to the project.
# Locally: npx vercel env pull .env.vercel
BLOB_READ_WRITE_TOKEN=

# --- The content guard ---
ANTHROPIC_API_KEY=

# Manual /api/cron calls. Vercel Cron signs its own with x-vercel-cron.
CRON_SECRET=

# --- SMS: NOT the live channel. See docs/COMPLIANCE.md before registering. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_CONVERSATIONS_SERVICE_SID=
DATABASE_URL=
