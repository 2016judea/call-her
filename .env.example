# Twilio — the one number the whole thing runs on
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+1612XXXXXXX
# Conversations service (auto-created on first run if blank)
TWILIO_CONVERSATIONS_SERVICE_SID=

# Postgres (Neon / Vercel Postgres)
DATABASE_URL=

# Claude — scrubs names and blocks explicit content before anything is relayed
ANTHROPIC_API_KEY=

# Shared secret for the daily cron
CRON_SECRET=
