{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 120 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 17 * * *" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
